{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/visits.py": {
      "maxDuration": 10,
      "excludeFiles": "{dist/**,tests/**,scripts/**,.github/**}"
    },
    "api/forecast.py": {
      "maxDuration": 25,
      "excludeFiles": "{dist/**,tests/**,scripts/**,.github/**}"
    }
  }
}
